DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/refactored_winner"
AUTH_SECRET="replace-with-a-long-random-secret"

# Gift-card provider integration. No gift-card operations are available without a real provider.
GIFT_CARD_PROVIDER="reloadly"
RELOADLY_CLIENT_ID="your-reloadly-client-id"
RELOADLY_CLIENT_SECRET="your-reloadly-client-secret"
RELOADLY_SANDBOX="true"
